<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Unity Ads cannot fill without these. ACCESS_NETWORK_STATE lets the SDK
         hold off on requests while the device is offline instead of burning them. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Advertising ID. Required on targetSdk 33+ for the SDK to read the ad ID at
         all; without it Unity can only ever serve non-personalized inventory. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application>
        <!-- Godot v2 plugin registration -->
        <meta-data
            android:name="org.godotengine.plugin.v2.GodotUnityAds"
            android:value="com.niquewrld.casino.unityads.GodotUnityAds" />
    </application>

</manifest>
