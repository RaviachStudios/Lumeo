rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function scoreOk() {
      return request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 9999;
    }

    // All-time leaderboards. Public read so anyone can see the boards;
    // each user may only write their own row, with a sane score. `allow
    // delete` is separate from `allow write` because a delete request has no
    // request.resource — folding scoreOk() (which reads request.resource.data)
    // into the same rule would error out and deny every delete.
    match /global_easy/{uid} {
      allow read: if true;
      allow write: if isUser(uid) && scoreOk();
      allow delete: if isUser(uid);
    }
    match /global_moderate/{uid} {
      allow read: if true;
      allow write: if isUser(uid) && scoreOk();
      allow delete: if isUser(uid);
    }
    match /global_hard/{uid} {
      allow read: if true;
      allow write: if isUser(uid) && scoreOk();
      allow delete: if isUser(uid);
    }

    // Daily leaderboards. Same write surface as the all-time boards, plus a
    // `date` field (UTC YYYY-MM-DD) and an `expires_at` (Firestore Timestamp
    // OR ISO-8601 string — TTL accepts both as the policy field). The screen
    // filters reads by `date == today_utc`, so even if TTL hasn't swept
    // yesterday's rows yet, they don't show up. NOT enforcing date == today
    // at write time: a player at exactly the midnight tick could write
    // tomorrow's date a few seconds early — that's strictly fairer than
    // rejecting their score for clock drift.
    // Daily rows are now keyed by `{date}__{uid}` (historical, one per day) so a
    // later replay can't overwrite a closed day's board — the reward flow reads
    // those past boards back. Ownership comes from a `uid` field validated against
    // auth (same pattern as contest_members below).
    //
    // ROLLOUT COMPAT: already-released app versions still write the LEGACY shape
    // (doc id == uid, no `uid` field). We accept both so those clients keep
    // working until users update: a write is OK if it's the new shape
    // (data.uid == auth.uid) OR the legacy shape (docId == auth.uid). The shared
    // field checks (score/date/expires) apply to both; the `uid` field is only
    // required-and-checked on the new shape. Once old versions age out this can
    // collapse back to the new shape only.
    function dailyRowOk() {
      return scoreOk()
          && request.resource.data.date is string
          && request.resource.data.date.size() == 10
          && (!('expires_at' in request.resource.data)
              || request.resource.data.expires_at is timestamp
              || request.resource.data.expires_at is string);
    }
    function dailyOwner(docId) {
      // New shape carries uid; legacy shape is keyed by uid (docId).
      return request.auth != null
          && ( (request.resource.data.uid is string
                && request.resource.data.uid == request.auth.uid)
               || docId == request.auth.uid );
    }
    match /daily_easy/{docId} {
      allow read: if true;
      allow write: if dailyOwner(docId) && dailyRowOk();
      allow delete: if request.auth != null
          && (docId == request.auth.uid || resource.data.uid == request.auth.uid);
    }
    match /daily_moderate/{docId} {
      allow read: if true;
      allow write: if dailyOwner(docId) && dailyRowOk();
      allow delete: if request.auth != null
          && (docId == request.auth.uid || resource.data.uid == request.auth.uid);
    }
    match /daily_hard/{docId} {
      allow read: if true;
      allow write: if dailyOwner(docId) && dailyRowOk();
      allow delete: if request.auth != null
          && (docId == request.auth.uid || resource.data.uid == request.auth.uid);
    }

    // ---- Score histogram (scale-invariant leaderboard rank) ---------------
    // Materialized view of the all-time boards: for each score value, how many
    // players hold it as their best. A player's rank is then read in a FIXED
    // number of reads (sum the counts above their score) instead of an O(N)
    // count() aggregation that grows with the board. Sharded as
    // board_hist/{board}_{k} so per-submit writes spread across HIST_SHARDS docs.
    //
    // Maintained client-side via the REST :commit atomic `increment` transform
    // (the Android plugin can't do atomic ops), which carries no native-auth
    // token — so writes are public, matching the client-trusted posture of the
    // boards themselves (see LeaderboardManager). A bad writer can only skew rank
    // NUMBERS, never the podium (that still derives from the auth-guarded per-uid
    // rows), and rebuild_histograms() heals any drift from the source-of-truth
    // rows. Structure is bounded: the doc holds only a `counts` map, size-capped
    // to the score domain (0..9999) so it can't be bloated with junk keys.
    match /board_hist/{docId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['counts'])
          && request.resource.data.counts is map
          && request.resource.data.counts.size() <= 10001;
    }

    // Private wallet doc: coin balance, owned/equipped theme, login streak
    // (streak_days + first_login_at), display name, last claim date.
    // Owner-only. Fields are validated only when present so partial (merge)
    // writes don't have to set every field at once.
    match /users/{uid} {
      allow read:   if isUser(uid);
      allow delete: if isUser(uid);
      allow write: if isUser(uid)
        && (!('coins' in request.resource.data)
            || (request.resource.data.coins is int
                && request.resource.data.coins >= 0
                && request.resource.data.coins <= 100000000))
        && (!('streak_days' in request.resource.data)
            || (request.resource.data.streak_days is int
                && request.resource.data.streak_days >= 0
                && request.resource.data.streak_days <= 1000000))
        && (!('last_claim_date' in request.resource.data)
            || (request.resource.data.last_claim_date is string
                && request.resource.data.last_claim_date.size() <= 10))
        && (!('first_login_at' in request.resource.data)
            || (request.resource.data.first_login_at is string
                && request.resource.data.first_login_at.size() <= 32))
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string
                && request.resource.data.name.size() <= 32))
        && (!('selected_theme' in request.resource.data)
            || (request.resource.data.selected_theme is string
                && request.resource.data.selected_theme.size() <= 32))
        && (!('owned_themes' in request.resource.data)
            || (request.resource.data.owned_themes is map
                && request.resource.data.owned_themes.size() <= 64))
        && (!('owned_levels' in request.resource.data)
            || (request.resource.data.owned_levels is map
                && request.resource.data.owned_levels.size() <= 16))
        // Lifetime coins earned via gameplay + daily claims (excludes IAP).
        // Same upper bound as `coins` so a bad write can't claim absurd totals.
        && (!('earned_coins' in request.resource.data)
            || (request.resource.data.earned_coins is int
                && request.resource.data.earned_coins >= 0
                && request.resource.data.earned_coins <= 100000000))
        // Real-money purchase audit trail. Shape: { sku: { iso_ts: true } }.
        // Cap the SKU count (32 distinct products is generous) — per-SKU
        // timestamp count is left unbounded since rules can't recurse into
        // nested maps, but the wallet doc itself is capped by Firestore's
        // 1MB document limit, which is plenty for years of normal usage.
        && (!('purchase_history' in request.resource.data)
            || (request.resource.data.purchase_history is map
                && request.resource.data.purchase_history.size() <= 32))
        // Non-consumable remove-ads entitlement. Bool flag, validated only
        // when present so other merge writes don't have to set it.
        && (!('has_remove_ads' in request.resource.data)
            || request.resource.data.has_remove_ads is bool)
        // First-run home-tour "seen" flag. Bool, validated only when present.
        && (!('tutorial_seen' in request.resource.data)
            || request.resource.data.tutorial_seen is bool)
        // Earned-badges bitfield: 256 bits packed into 32 bytes, base64-encoded
        // (~44 chars). One compact string regardless of how many are earned.
        && (!('badges' in request.resource.data)
            || (request.resource.data.badges is string
                && request.resource.data.badges.size() <= 64))
        // All-time leaderboard reward tracker: { diff: best_band_index }. Small
        // map (3 difficulties). Values are trusted like the rest of the wallet.
        && (!('alltime_reward_bands' in request.resource.data)
            || (request.resource.data.alltime_reward_bands is map
                && request.resource.data.alltime_reward_bands.size() <= 8))
        // Most recent day whose daily-standing reward has been resolved (UTC
        // YYYY-MM-DD). Same shape/bound as last_claim_date.
        && (!('last_daily_reward_date' in request.resource.data)
            || (request.resource.data.last_daily_reward_date is string
                && request.resource.data.last_daily_reward_date.size() <= 10));
    }

    // ---- Arena rooms -------------------------------------------------------
    // There is no server (no Cloud Functions), and the Android Firebase plugin
    // can only listen to a SINGLE document — so an entire room (lobby -> race ->
    // results) lives in ONE doc and every client attaches a document listener to
    // it. Each client merge-writes only its own entry under `players.<uid>`.
    //
    // contests/{CID} -> { creator_uid, difficulty, is_public, status, seed,
    //                     member_count, players:{ uid:{ name, state, score, ... } },
    //                     ... } ; expires_at is the TTL field.
    //
    // Trust model: scores/standings are client-trusted (same posture as the
    // leaderboards above). Rules bound STRUCTURE only — immutable identity fields,
    // the status enum, member_count range, players is a bounded map, and the
    // writer must appear in the resulting players map. A shared room doc cannot be
    // defended key-by-key, which is an accepted, pre-existing trade-off.

    // Player-authored room title: validated only when present so merge writes
    // (member_count bumps, start, finalize) don't have to resend it.
    function titleOk() {
      return !('title' in request.resource.data)
          || (request.resource.data.title is string
              && request.resource.data.title.size() >= 1
              && request.resource.data.title.size() <= 15);
    }
    // Lobby discoverability fields (validated only when present, so merge writes
    // that don't touch them still pass). `is_public` marks a room listed in the
    // browse-lobby; `lobby_key` is the uniform random sort key the lobby query
    // ranges over (public+lobby only; started rooms drop it below the [0,1) range).
    function lobbyFieldsOk() {
      return (!('is_public' in request.resource.data)
              || request.resource.data.is_public is bool)
          && (!('lobby_key' in request.resource.data)
              || request.resource.data.lobby_key is number);
    }
    // The players roster is a map capped at the room size; validated only when
    // present so writes that don't touch it (e.g. member_count bump) still pass.
    function playersOk() {
      return !('players' in request.resource.data)
          || (request.resource.data.players is map
              && request.resource.data.players.size() <= 45);
    }
    // `seed` (shared RNG for the race) is an int when present.
    function seedOk() {
      return !('seed' in request.resource.data)
          || request.resource.data.seed is int;
    }

    match /contests/{cid} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.creator_uid == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.difficulty in ['easy', 'moderate', 'hard']
        && request.resource.data.member_count is int
        && playersOk() && seedOk()
        && titleOk() && lobbyFieldsOk();

      // Any signed-in participant may update the room (join adds their player key;
      // the creator starts it and stamps the seed; anyone racing writes their own
      // score; whoever observes all-done writes status:finished). Immutable identity
      // fields must not change, status stays in the known set, member_count stays in
      // range, and the writer must appear in the resulting players map.
      allow update: if request.auth != null
        && request.resource.data.creator_uid == resource.data.creator_uid
        && request.resource.data.difficulty == resource.data.difficulty
        && request.resource.data.status in ['lobby', 'playing', 'finished']
        && request.resource.data.member_count is int
        && request.resource.data.member_count >= 0
        && request.resource.data.member_count <= 45
        && request.auth.uid in request.resource.data.players
        && playersOk() && seedOk()
        && titleOk() && lobbyFieldsOk();

      // The creator can delete anytime (cancel); anyone can delete an empty room
      // (last member out). member_count is lowered to 0 before that delete, so the
      // empty-delete path is reachable by a non-creator.
      allow delete: if request.auth != null
        && (resource.data.creator_uid == request.auth.uid
            || resource.data.member_count <= 0);
    }
  }
}
