rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function scoreOk() {
      return request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 9999;
    }

    // All-time leaderboards. Public read so anyone can see the boards;
    // each user may only write their own row, with a sane score. `allow
    // delete` is separate from `allow write` because a delete request has no
    // request.resource — folding scoreOk() (which reads request.resource.data)
    // into the same rule would error out and deny every delete.
    match /global_easy/{uid} {
      allow read: if true;
      allow write: if isUser(uid) && scoreOk();
      allow delete: if isUser(uid);
    }
    match /global_moderate/{uid} {
      allow read: if true;
      allow write: if isUser(uid) && scoreOk();
      allow delete: if isUser(uid);
    }
    match /global_hard/{uid} {
      allow read: if true;
      allow write: if isUser(uid) && scoreOk();
      allow delete: if isUser(uid);
    }

    // Daily leaderboards. Same write surface as the all-time boards, plus a
    // `date` field (UTC YYYY-MM-DD) and an `expires_at` (Firestore Timestamp
    // OR ISO-8601 string — TTL accepts both as the policy field). The screen
    // filters reads by `date == today_utc`, so even if TTL hasn't swept
    // yesterday's rows yet, they don't show up. NOT enforcing date == today
    // at write time: a player at exactly the midnight tick could write
    // tomorrow's date a few seconds early — that's strictly fairer than
    // rejecting their score for clock drift.
    function dailyRowOk() {
      return scoreOk()
          && request.resource.data.date is string
          && request.resource.data.date.size() == 10
          && (!('expires_at' in request.resource.data)
              || request.resource.data.expires_at is timestamp
              || request.resource.data.expires_at is string);
    }
    match /daily_easy/{uid} {
      allow read: if true;
      allow write: if isUser(uid) && dailyRowOk();
      allow delete: if isUser(uid);
    }
    match /daily_moderate/{uid} {
      allow read: if true;
      allow write: if isUser(uid) && dailyRowOk();
      allow delete: if isUser(uid);
    }
    match /daily_hard/{uid} {
      allow read: if true;
      allow write: if isUser(uid) && dailyRowOk();
      allow delete: if isUser(uid);
    }

    // Private wallet doc: coin balance, owned/equipped theme, login streak
    // (streak_days + first_login_at), display name, last claim date.
    // Owner-only. Fields are validated only when present so partial (merge)
    // writes don't have to set every field at once.
    match /users/{uid} {
      allow read:   if isUser(uid);
      allow delete: if isUser(uid);
      allow write: if isUser(uid)
        && (!('coins' in request.resource.data)
            || (request.resource.data.coins is int
                && request.resource.data.coins >= 0
                && request.resource.data.coins <= 100000000))
        && (!('streak_days' in request.resource.data)
            || (request.resource.data.streak_days is int
                && request.resource.data.streak_days >= 0
                && request.resource.data.streak_days <= 1000000))
        && (!('last_claim_date' in request.resource.data)
            || (request.resource.data.last_claim_date is string
                && request.resource.data.last_claim_date.size() <= 10))
        && (!('first_login_at' in request.resource.data)
            || (request.resource.data.first_login_at is string
                && request.resource.data.first_login_at.size() <= 32))
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string
                && request.resource.data.name.size() <= 32))
        && (!('selected_theme' in request.resource.data)
            || (request.resource.data.selected_theme is string
                && request.resource.data.selected_theme.size() <= 32))
        && (!('owned_themes' in request.resource.data)
            || (request.resource.data.owned_themes is map
                && request.resource.data.owned_themes.size() <= 64))
        && (!('owned_levels' in request.resource.data)
            || (request.resource.data.owned_levels is map
                && request.resource.data.owned_levels.size() <= 16))
        // Lifetime coins earned via gameplay + daily claims (excludes IAP).
        // Same upper bound as `coins` so a bad write can't claim absurd totals.
        && (!('earned_coins' in request.resource.data)
            || (request.resource.data.earned_coins is int
                && request.resource.data.earned_coins >= 0
                && request.resource.data.earned_coins <= 100000000))
        // Real-money purchase audit trail. Shape: { sku: { iso_ts: true } }.
        // Cap the SKU count (32 distinct products is generous) — per-SKU
        // timestamp count is left unbounded since rules can't recurse into
        // nested maps, but the wallet doc itself is capped by Firestore's
        // 1MB document limit, which is plenty for years of normal usage.
        && (!('purchase_history' in request.resource.data)
            || (request.resource.data.purchase_history is map
                && request.resource.data.purchase_history.size() <= 32))
        // Non-consumable remove-ads entitlement. Bool flag, validated only
        // when present so other merge writes don't have to set it.
        && (!('has_remove_ads' in request.resource.data)
            || request.resource.data.has_remove_ads is bool)
        // First-run home-tour "seen" flag. Bool, validated only when present.
        && (!('tutorial_seen' in request.resource.data)
            || request.resource.data.tutorial_seen is bool);
    }

    // ---- Arena contests ----------------------------------------------------
    // There is no server (no Cloud Functions), so finalization/standings are
    // written by clients. Rules bound what they can (types, enums, counts, the
    // status transition space, per-user row ownership); the score/standings
    // values themselves are trusted, exactly like the leaderboard scores above.
    //
    // contests/{CID}                -> meta (public read; short random ID is the
    //                                  share token). expires_at is the TTL field.
    // contest_members/{CID__uid}    -> one row per participant. Each user writes
    //                                  only their own row; the creator may delete
    //                                  any row (kick). expires_at is the TTL field.

    function contestData(cid) {
      return get(/databases/$(database)/documents/contests/$(cid)).data;
    }
    function memberScoreOk() {
      return request.resource.data.best_score is int
          && request.resource.data.best_score >= 0
          && request.resource.data.best_score <= 9999;
    }
    // Player-authored contest title: validated only when present so merge writes
    // (member_count bumps, start, finalize) don't have to resend it.
    function titleOk() {
      return !('title' in request.resource.data)
          || (request.resource.data.title is string
              && request.resource.data.title.size() >= 1
              && request.resource.data.title.size() <= 15);
    }

    match /contests/{cid} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.creator_uid == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.type in ['one_game', 'one_hour', 'one_day', 'daily']
        && request.resource.data.difficulty in ['easy', 'moderate', 'hard']
        && request.resource.data.member_count is int
        && titleOk();

      // Any signed-in participant may update the meta (join bumps member_count;
      // the creator starts it; anyone may write the finalized standings). The
      // immutable identity fields must not change, member_count stays in range,
      // and status only ever sits in the known set.
      allow update: if request.auth != null
        && request.resource.data.creator_uid == resource.data.creator_uid
        && request.resource.data.type == resource.data.type
        && request.resource.data.difficulty == resource.data.difficulty
        && request.resource.data.status in ['lobby', 'active', 'finished']
        && request.resource.data.member_count is int
        && request.resource.data.member_count >= 0
        && request.resource.data.member_count <= 45
        && titleOk();

      // The creator can delete anytime (cancel); anyone can delete an empty
      // contest (last member out). member_count is lowered to 0 before that
      // delete, so the empty-delete path is reachable by a non-creator.
      allow delete: if request.auth != null
        && (resource.data.creator_uid == request.auth.uid
            || resource.data.member_count <= 0);
    }

    match /contest_members/{docId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.contest_id is string
        && memberScoreOk();

      // Only the owner edits their own row; best_score stays sane.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && memberScoreOk();

      // Owner leaves, OR the contest's creator kicks. The creator lookup only
      // runs for a non-owner delete (|| short-circuits) so a normal self-leave
      // never depends on the contest doc still existing.
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || request.auth.uid == contestData(resource.data.contest_id).creator_uid);
    }
  }
}
