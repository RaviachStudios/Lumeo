rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function scoreOk() {
      return request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 9999;
    }

    // ---- client-swept expiry (the replacement for Firestore TTL) -----------
    // Firestore TTL policies only act on fields of type Timestamp, and the
    // Android Firebase plugin cannot produce one: set_document() marshals a
    // GDScript String to a Java String, so `expires_at` has always landed as a
    // STRING and the TTL policies on contests/daily_* have never deleted a
    // single document. (The 4 console TTL policies are inert; harmless to leave.)
    //
    // So expiry is enforced HERE instead: every doc also carries `expires_unix`
    // (plain int, UTC seconds), and once that moment has passed ANY signed-in
    // client may delete the doc. Clients sweep opportunistically — the
    // leaderboards warm-up and the lobby open each reap a bounded batch — so
    // garbage is collected by whoever shows up next, with no server involved.
    //
    // Safety: expires_unix can only ever be written by someone already allowed
    // to write that doc (its owner / a room member), so nobody can backdate
    // ANOTHER player's row to make it deletable. The worst a client can do is
    // shorten the life of its own data.
    function isExpired() {
      return 'expires_unix' in resource.data
          && resource.data.expires_unix is int
          && request.time.toMillis() > resource.data.expires_unix * 1000;
    }
    // Writers may omit it (merge writes that don't touch expiry, plus already-
    // released builds that predate the field); when present it must be an int.
    function expiresUnixOk() {
      return !('expires_unix' in request.resource.data)
          || request.resource.data.expires_unix is int;
    }

    // All-time leaderboards. Public read so anyone can see the boards;
    // each user may only write their own row, with a sane score. `allow
    // delete` is separate from `allow write` because a delete request has no
    // request.resource — folding scoreOk() (which reads request.resource.data)
    // into the same rule would error out and deny every delete.
    match /global_easy/{uid} {
      allow read: if true;
      allow write: if isUser(uid) && scoreOk();
      allow delete: if isUser(uid);
    }
    match /global_moderate/{uid} {
      allow read: if true;
      allow write: if isUser(uid) && scoreOk();
      allow delete: if isUser(uid);
    }
    match /global_hard/{uid} {
      allow read: if true;
      allow write: if isUser(uid) && scoreOk();
      allow delete: if isUser(uid);
    }

    // Daily leaderboards. Same write surface as the all-time boards, plus a
    // `date` field (UTC YYYY-MM-DD), an `expires_unix` (int, the field expiry
    // actually keys on — see isExpired above) and a legacy `expires_at` ISO
    // string kept only so already-released builds keep validating. The screen
    // filters reads by `date == today_utc`, so even if nobody has swept
    // yesterday's rows yet, they don't show up. NOT enforcing date == today
    // at write time: a player at exactly the midnight tick could write
    // tomorrow's date a few seconds early — that's strictly fairer than
    // rejecting their score for clock drift.
    // Daily rows are now keyed by `{date}__{uid}` (historical, one per day) so a
    // later replay can't overwrite a closed day's board — the reward flow reads
    // those past boards back. Ownership comes from a `uid` field validated against
    // auth (same pattern as contest_members below).
    //
    // ROLLOUT COMPAT: already-released app versions still write the LEGACY shape
    // (doc id == uid, no `uid` field). We accept both so those clients keep
    // working until users update: a write is OK if it's the new shape
    // (data.uid == auth.uid) OR the legacy shape (docId == auth.uid). The shared
    // field checks (score/date/expires) apply to both; the `uid` field is only
    // required-and-checked on the new shape. Once old versions age out this can
    // collapse back to the new shape only.
    function dailyRowOk() {
      return scoreOk()
          && request.resource.data.date is string
          && request.resource.data.date.size() == 10
          && (!('expires_at' in request.resource.data)
              || request.resource.data.expires_at is timestamp
              || request.resource.data.expires_at is string)
          && expiresUnixOk();
    }
    function dailyOwner(docId) {
      // New shape carries uid; legacy shape is keyed by uid (docId).
      return request.auth != null
          && ( (request.resource.data.uid is string
                && request.resource.data.uid == request.auth.uid)
               || docId == request.auth.uid );
    }
    match /daily_easy/{docId} {
      allow read: if true;
      allow write: if dailyOwner(docId) && dailyRowOk();
      // isExpired() is checked FIRST because it is the only arm safe on every row
      // shape: it existence-checks its field, whereas reading resource.data.uid
      // on a legacy row (which has none) raises and denies before a later arm
      // could run.
      allow delete: if request.auth != null
          && (isExpired()
              || docId == request.auth.uid
              || resource.data.uid == request.auth.uid);
    }
    match /daily_moderate/{docId} {
      allow read: if true;
      allow write: if dailyOwner(docId) && dailyRowOk();
      // isExpired() is checked FIRST because it is the only arm safe on every row
      // shape: it existence-checks its field, whereas reading resource.data.uid
      // on a legacy row (which has none) raises and denies before a later arm
      // could run.
      allow delete: if request.auth != null
          && (isExpired()
              || docId == request.auth.uid
              || resource.data.uid == request.auth.uid);
    }
    match /daily_hard/{docId} {
      allow read: if true;
      allow write: if dailyOwner(docId) && dailyRowOk();
      // isExpired() is checked FIRST because it is the only arm safe on every row
      // shape: it existence-checks its field, whereas reading resource.data.uid
      // on a legacy row (which has none) raises and denies before a later arm
      // could run.
      allow delete: if request.auth != null
          && (isExpired()
              || docId == request.auth.uid
              || resource.data.uid == request.auth.uid);
    }

    // ---- Score histogram (scale-invariant leaderboard rank) ---------------
    // Materialized view of the all-time boards: for each score value, how many
    // players hold it as their best. A player's rank is then read in a FIXED
    // number of reads (sum the counts above their score) instead of an O(N)
    // count() aggregation that grows with the board. Sharded as
    // board_hist/{board}_{k} so per-submit writes spread across HIST_SHARDS docs.
    //
    // Maintained client-side via the REST :commit atomic `increment` transform
    // (the Android plugin can't do atomic ops), which carries no native-auth
    // token — so writes are public, matching the client-trusted posture of the
    // boards themselves (see LeaderboardManager). A bad writer can only skew rank
    // NUMBERS, never the podium (that still derives from the auth-guarded per-uid
    // rows), and rebuild_histograms() heals any drift from the source-of-truth
    // rows. Structure is bounded: the doc holds only a `counts` map, size-capped
    // to the score domain (0..9999) so it can't be bloated with junk keys.
    match /board_hist/{docId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['counts'])
          && request.resource.data.counts is map
          && request.resource.data.counts.size() <= 10001;
    }

    // ---- Materialized top-N boards (server-written) -----------------------
    // One doc per leaderboard family holds all three difficulties' top-N lists:
    //   board_top/global -> { boards:{easy:[...],moderate:[...],hard:[...]}, updated_unix }
    //   board_top/daily  -> { date, boards:{...}, updated_unix }
    // Clients READ this so a whole family's top lists cost ONE read instead of
    // 3x20. Unlike the boards/histogram/lobby (which are client-trusted because
    // there's no server on those paths), this doc has a real writer: a scheduled
    // Cloud Function (functions/index.js) using the Admin SDK, which bypasses
    // these rules. So we can lock writes off for ALL clients — the materialized
    // list is therefore un-forgeable, unlike a client-maintained aggregate would
    // be. A tampered client can't inject fake podium entries here; the worst it
    // can still do is skew its OWN per-uid row (guarded above) which the function
    // re-derives the list from anyway.
    match /board_top/{docId} {
      allow read: if true;
      allow write: if false;   // server-only (Admin SDK bypasses rules)
    }

    // Private wallet doc: coin balance, owned/equipped theme, login streak
    // (streak_days + first_login_at), display name, last claim date.
    // Owner-only. Fields are validated only when present so partial (merge)
    // writes don't have to set every field at once.
    match /users/{uid} {
      allow read:   if isUser(uid);
      allow delete: if isUser(uid);
      allow write: if isUser(uid)
        && (!('coins' in request.resource.data)
            || (request.resource.data.coins is int
                && request.resource.data.coins >= 0
                && request.resource.data.coins <= 100000000))
        && (!('streak_days' in request.resource.data)
            || (request.resource.data.streak_days is int
                && request.resource.data.streak_days >= 0
                && request.resource.data.streak_days <= 1000000))
        && (!('last_claim_date' in request.resource.data)
            || (request.resource.data.last_claim_date is string
                && request.resource.data.last_claim_date.size() <= 10))
        && (!('first_login_at' in request.resource.data)
            || (request.resource.data.first_login_at is string
                && request.resource.data.first_login_at.size() <= 32))
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string
                && request.resource.data.name.size() <= 32))
        && (!('selected_theme' in request.resource.data)
            || (request.resource.data.selected_theme is string
                && request.resource.data.selected_theme.size() <= 32))
        && (!('owned_themes' in request.resource.data)
            || (request.resource.data.owned_themes is map
                && request.resource.data.owned_themes.size() <= 64))
        && (!('owned_levels' in request.resource.data)
            || (request.resource.data.owned_levels is map
                && request.resource.data.owned_levels.size() <= 16))
        // Button-frame cosmetics (the modelled Medium + Hard boards share ONE
        // global selection). One equipped id + a map of owned ids, same shape and
        // bounds as the theme pair above. The catalog is 15 cosmetics plus a
        // permanently-owned "default" that is never stored, so 64 is generous;
        // the longest id ("obsidian_chrome") is 15 characters. Which ids are legal
        // is a client-side question — ButtonFrames.has_frame() drops anything it
        // does not know on load, so an unknown id can never end up equipped.
        && (!('selected_frame' in request.resource.data)
            || (request.resource.data.selected_frame is string
                && request.resource.data.selected_frame.size() <= 32))
        && (!('owned_frames' in request.resource.data)
            || (request.resource.data.owned_frames is map
                && request.resource.data.owned_frames.size() <= 64))
        // Lifetime coins earned via gameplay + daily claims (excludes IAP).
        // Same upper bound as `coins` so a bad write can't claim absurd totals.
        && (!('earned_coins' in request.resource.data)
            || (request.resource.data.earned_coins is int
                && request.resource.data.earned_coins >= 0
                && request.resource.data.earned_coins <= 100000000))
        // Real-money purchase audit trail. Shape: { sku: { iso_ts: true } }.
        // Cap the SKU count (32 distinct products is generous) — per-SKU
        // timestamp count is left unbounded since rules can't recurse into
        // nested maps, but the wallet doc itself is capped by Firestore's
        // 1MB document limit, which is plenty for years of normal usage.
        && (!('purchase_history' in request.resource.data)
            || (request.resource.data.purchase_history is map
                && request.resource.data.purchase_history.size() <= 32))
        // Non-consumable remove-ads entitlement. Bool flag, validated only
        // when present so other merge writes don't have to set it.
        && (!('has_remove_ads' in request.resource.data)
            || request.resource.data.has_remove_ads is bool)
        // First-run home-tour "seen" flag. Bool, validated only when present.
        && (!('tutorial_seen' in request.resource.data)
            || request.resource.data.tutorial_seen is bool)
        // Earned-badges bitfield: 256 bits packed into 32 bytes, base64-encoded
        // (~44 chars). One compact string regardless of how many are earned.
        && (!('badges' in request.resource.data)
            || (request.resource.data.badges is string
                && request.resource.data.badges.size() <= 64))
        // Today's daily-task board: { date, counters:{...}, claimed:{...} }. One
        // small map, rewritten wholesale as progress ticks. The coins it pays out
        // land in `coins` (bounded above) — this field only records what has been
        // completed and collected, so it is trusted like the rest of the wallet and
        // only its top-level shape is checked here.
        && (!('daily_tasks' in request.resource.data)
            || (request.resource.data.daily_tasks is map
                && request.resource.data.daily_tasks.size() <= 8))
        // All-time leaderboard reward tracker: { diff: best_band_index }. Small
        // map (3 difficulties). Values are trusted like the rest of the wallet.
        && (!('alltime_reward_bands' in request.resource.data)
            || (request.resource.data.alltime_reward_bands is map
                && request.resource.data.alltime_reward_bands.size() <= 8))
        // Most recent day whose daily-standing reward has been resolved (UTC
        // YYYY-MM-DD). Now written by the midnight Cloud Function as its idempotency
        // high-watermark (Admin SDK bypasses these rules); the shape is still
        // validated so a client merge that carries the field forward stays legal.
        && (!('last_daily_reward_date' in request.resource.data)
            || (request.resource.data.last_daily_reward_date is string
                && request.resource.data.last_daily_reward_date.size() <= 10))
        // Server-written receipts for closed-day daily rewards, keyed by date:
        // { "YYYY-MM-DD": {total, results, date} }. The Cloud Function writes them
        // (and credits the coins); the client only ever CLEARS consumed keys (writes
        // back an empty / smaller map), which has no economic effect on its own —
        // the coins live in the separate `coins` field. Bounded so it can't bloat.
        && (!('pending_daily_rewards' in request.resource.data)
            || (request.resource.data.pending_daily_rewards is map
                && request.resource.data.pending_daily_rewards.size() <= 60))
        // Arena "one room at a time" pointer: the CID of the room this player is
        // currently seated in, or "" when in none. A 6-char room ID (ID_LEN) at
        // most; validated only when present so other merge writes needn't set it.
        && (!('current_room' in request.resource.data)
            || (request.resource.data.current_room is string
                && request.resource.data.current_room.size() <= 6))
        // Display cache for the seated room, so the Arena hub paints its "return to
        // your room" card instantly (no network read). The room's NAME (<= TITLE_MAX,
        // with slack) and whether we host it. Both purely cosmetic — the authoritative
        // room read still governs everything — so they're trusted like the rest of the
        // wallet and validated only for shape when present.
        && (!('current_room_title' in request.resource.data)
            || (request.resource.data.current_room_title is string
                && request.resource.data.current_room_title.size() <= 32))
        && (!('current_room_host' in request.resource.data)
            || request.resource.data.current_room_host is bool);
    }

    // ---- Arena rooms -------------------------------------------------------
    // There is no server (no Cloud Functions), and the Android Firebase plugin
    // can only listen to a SINGLE document — so an entire room (lobby -> race ->
    // results) lives in ONE doc and every client attaches a document listener to
    // it. Each client merge-writes only its own entry under `players.<uid>`.
    //
    // contests/{CID} -> { creator_uid, difficulty, is_public, status, seed,
    //                     member_count, players:{ uid:{ name, state, score, ... } },
    //                     ... } ; expires_at is the TTL field.
    //
    // Trust model: scores/standings are client-trusted (same posture as the
    // leaderboards above). Rules bound STRUCTURE only — immutable identity fields,
    // the status enum, member_count range, players is a bounded map, and the
    // writer must appear in the resulting players map. A shared room doc cannot be
    // defended key-by-key, which is an accepted, pre-existing trade-off.

    // Player-authored room title: validated only when present so merge writes
    // (member_count bumps, start, finalize) don't have to resend it.
    function titleOk() {
      return !('title' in request.resource.data)
          || (request.resource.data.title is string
              && request.resource.data.title.size() >= 1
              && request.resource.data.title.size() <= 15);
    }
    // Lobby discoverability fields (validated only when present, so merge writes
    // that don't touch them still pass). `is_public` marks a room listed in the
    // browse-lobby; `lobby_shard` says which /lobby/s{N} index doc lists it and
    // `start_deadline` is the unix second the host must have started by.
    // `lobby_key` is the LEGACY random sort key that already-released builds range
    // over (public+lobby only; started rooms drop it below the [0,1) range) — new
    // clients still write it so those builds keep working.
    function lobbyFieldsOk() {
      return (!('is_public' in request.resource.data)
              || request.resource.data.is_public is bool)
          && (!('lobby_key' in request.resource.data)
              || request.resource.data.lobby_key is number)
          && (!('lobby_shard' in request.resource.data)
              || request.resource.data.lobby_shard is int)
          && (!('start_deadline' in request.resource.data)
              || request.resource.data.start_deadline is int);
    }
    // The players roster is a map capped at the room size; validated only when
    // present so writes that don't touch it (e.g. member_count bump) still pass.
    function playersOk() {
      return !('players' in request.resource.data)
          || (request.resource.data.players is map
              && request.resource.data.players.size() <= 45);
    }
    // `seed` (shared RNG for the race) is an int when present.
    function seedOk() {
      return !('seed' in request.resource.data)
          || request.resource.data.seed is int;
    }
    // Set when the HOST ended the room rather than the race running to its end
    // (contest_manager.gd _close_room). Closing is a WRITE, not a delete, because the
    // Android listener never fires for a deleted document — so this flag, riding along
    // with status "finished", is how everyone still sitting in the room finds out.
    // Shape-checked only; like everything else on a shared room doc it is trusted.
    function cancelledOk() {
      return !('cancelled' in request.resource.data)
          || request.resource.data.cancelled is bool;
    }
    // A room's expiry may only ever be pushed INTO THE FUTURE. On a per-user doc a
    // backdated stamp can only shorten the life of your own data — but a room doc is
    // SHARED, and isExpired() lets any signed-in client delete an expired room, so on
    // `contests` a backdated stamp was a one-write way to hand a live 45-player race to
    // anyone who wanted it gone. Every real writer stamps now + TTL (or now +
    // CLOSED_LINGER), so this rejects nothing legitimate; a device whose clock is more
    // than the TTL slow can't write to rooms, which is the correct outcome — its
    // stamps would make its own rooms instantly reapable.
    function expiresFutureOk() {
      return !('expires_unix' in request.resource.data)
          || (request.resource.data.expires_unix is int
              && request.resource.data.expires_unix * 1000 > request.time.toMillis());
    }

    match /contests/{cid} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.creator_uid == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.difficulty in ['easy', 'moderate', 'hard']
        && request.resource.data.member_count is int
        && playersOk() && seedOk() && cancelledOk()
        && titleOk() && lobbyFieldsOk() && expiresFutureOk();

      // Any signed-in participant may update the room (join adds their player key;
      // the creator starts it and stamps the seed; anyone racing writes their own
      // score; whoever observes all-done writes status:finished). Immutable identity
      // fields must not change, status stays in the known set, member_count stays in
      // range, and the writer must appear in the resulting players map.
      allow update: if request.auth != null
        && request.resource.data.creator_uid == resource.data.creator_uid
        && request.resource.data.difficulty == resource.data.difficulty
        && request.resource.data.status in ['lobby', 'playing', 'finished']
        && request.resource.data.member_count is int
        && request.resource.data.member_count >= 0
        && request.resource.data.member_count <= 45
        && request.auth.uid in request.resource.data.players
        && playersOk() && seedOk() && cancelledOk()
        && titleOk() && lobbyFieldsOk() && expiresFutureOk();

      // Deleting a room is now a CLEANUP operation, not a way to end one.
      //
      // There used to be an "anyone may delete a room whose member_count <= 0" arm, for
      // the last member out. But any participant may write member_count (it's just a
      // field on the shared doc), so that pair was a two-write recipe for destroying a
      // live 45-player race — from any member, at any moment, with everyone's standings
      // in it. Ending a room is a WRITE now (contest_manager.gd _close_room), including
      // for the last member out, so nothing in the client needs that arm any more.
      //
      // What's left: the creator may delete their own room, and ANY signed-in client may
      // reap a genuinely expired one (isExpired) — which, with expiresFutureOk above
      // guarding the stamp, can no longer be forced early. Closed and abandoned rooms
      // are collected by that arm and by the scheduled server sweep.
      //
      // ROLLOUT NOTE: already-released clients still try the empty-room delete when the
      // last member leaves. That delete now fails, harmlessly — the room simply stays
      // until it expires, exactly like every other abandoned room, and it has already
      // left the browse list by the liveness predicate.
      allow delete: if request.auth != null
        && (resource.data.creator_uid == request.auth.uid
            || isExpired());
    }

    // ---- Public lobby index ------------------------------------------------
    // The browsable list of open public rooms. A client can't listen to a QUERY,
    // only to a document, so the list is fanned out into 5 fixed docs of 20 rooms
    // each — every lobby viewer listens to all 5 and merges them client-side:
    //
    //   lobby/s{0..4} -> { rooms: { <CID>: {t,d,c,o,u} } }
    //
    // 5 x 20 is the HARD CAP on open public rooms, and it is enforced right here:
    // a write that would put more than 20 entries in a shard is rejected. Entries
    // are never deleted key-by-key (a merge can't); a closed room is written o=0
    // and swept the next time the shard needs a free slot.
    //
    // Rules can't iterate a map, so individual entries are client-trusted — the
    // same posture as the room docs above and board_hist. Any signed-in player can
    // write, because any of them may open, join or close a room. Deleting a whole
    // shard is not allowed: the docs are permanent fixtures.
    match /lobby/{shard} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(['rooms'])
        && request.resource.data.rooms is map
        && request.resource.data.rooms.size() <= 20;
      allow delete: if false;
    }

    // ---- Arena materialized room state (server-written) --------------------
    // A coalesced, read-only mirror of contests/{cid} that UPDATED clients watch
    // instead of the raw room doc — so a burst of joins/scores no longer wakes
    // every member on every write. Written ONLY by the syncContest Cloud Function
    // (Admin SDK bypasses these rules); locked off for all clients, so — like
    // board_top — the standings it carries can't be forged. A missing doc (before
    // the function has run, or right after a room is created) just means the
    // client falls back to reading contests/{cid} directly.
    match /contest_state/{cid} {
      allow read: if true;
      allow write: if false;   // server-only (Admin SDK bypasses rules)
    }

    // ---- Arena public-lobby index (server-written, single doc) -------------
    // The entire open-public-room list in ONE doc (lobby_index/open), maintained
    // by syncContest. Updated clients READ it once per Refresh (one read for the
    // whole list) instead of holding 5 live shard listeners that take a push per
    // room event. Server-only, so the list is un-forgeable; clients still filter
    // liveness by now < o + START_WINDOW and the scheduled sweep prunes dead
    // entries. (The legacy lobby/s{N} shards above stay for not-yet-updated
    // clients.)
    match /lobby_index/{docId} {
      allow read: if true;
      allow write: if false;   // server-only (Admin SDK bypasses rules)
    }
  }
}
