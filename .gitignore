# Godot 4+ specific ignores
.godot/
/android/

# Firebase admin credentials (tools/purge_expired.js). Full-admin keys — never commit.
serviceAccount*.json
*-firebase-adminsdk-*.json
node_modules/

# Firebase CLI deploy cache — regenerated on every `firebase deploy`.
.firebase/

# Build artifacts (too large for GitHub; keep local only)
Lumeo.apk
Lumeo.aab
*.apk
*.aab

# Unity Ads plugin build (source is tracked; outputs and machine-local paths are not)
plugin_unityads/build/
plugin_unityads/.gradle/
plugin_unityads/local.properties
plugin_unityads/libs/*.aar
